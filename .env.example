# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Auto-provisioned by the Vercel Neon integration in production.
# Locally: connect Neon in the Vercel dashboard, then `vercel env pull .env.local`,
# or create a free Neon project and paste its connection string here.
DATABASE_URL=

# ── App password gate ───────────────────────────────────────────────────────
# The single password to enter the app.
APP_PASSWORD=change-me
# Long random string used to sign the auth cookie: `openssl rand -hex 32`
AUTH_SECRET=

# ── Cron trigger secret ─────────────────────────────────────────────────────
# Shared secret sent as `Authorization: Bearer <CRON_SECRET>` to /api/cron by
# the GitHub Actions workflow (and Vercel cron): `openssl rand -hex 32`
CRON_SECRET=

# ── Optional: FRED macro data ───────────────────────────────────────────────
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Omit to hide the live macro chips (the app still works).
FRED_API_KEY=

# ── Optional: AI daily-brief narrative ──────────────────────────────────────
# Anthropic API key (https://console.anthropic.com) enables the AI "why" in the
# autonomous daily journal brief. Without it, the brief still generates the
# deterministic facts + real headlines. Costs a few cents/day on the default model.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-4-5 — cheap, daily). Bump to
# claude-sonnet-4-6 or claude-opus-4-8 for deeper analysis.
BRIEF_MODEL=
